{
  "manifest_version": 3,
  "name": "Nexus Manga Auto-Translator",
  "version": "1.0",
  "description": "Auto translate MangaDex chapters directly on page, plus standalone single image translation.",
  "permissions": [
    "activeTab",
    "clipboardRead",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexus Translate",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
